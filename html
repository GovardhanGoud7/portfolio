<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>L. Govardhan Goud — Portfolio</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#0F1512;
    --panel:#151D19;
    --paper:#F2EFE6;
    --paper-dim:#CFCABB;
    --amber:#E3A44C;
    --moss:#7FA07A;
    --line: rgba(242,239,230,0.12);
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    background:var(--ink);
    color:var(--paper);
    font-family:'Inter',sans-serif;
    line-height:1.6;
  }
  ::selection{background:var(--amber);color:var(--ink);}

  a{color:inherit;text-decoration:none;}

  .wrap{
    max-width:920px;
    margin:0 auto;
    padding:0 28px;
  }

  /* ---------- Nav ---------- */
  header.top{
    position:sticky;top:0;z-index:50;
    background:rgba(15,21,18,0.9);
    backdrop-filter:blur(8px);
    border-bottom:1px solid var(--line);
  }
  .navrow{
    display:flex;justify-content:space-between;align-items:center;
    padding:16px 28px;max-width:920px;margin:0 auto;
  }
  .brand{
    font-family:'JetBrains Mono',monospace;
    font-weight:700;font-size:15px;letter-spacing:0.3px;
    color:var(--paper);
  }
  .brand span{color:var(--amber);}
  nav.links{display:flex;gap:26px;font-size:14px;}
  nav.links a{color:var(--paper-dim);transition:color .15s ease;}
  nav.links a:hover{color:var(--amber);}
  .navtoggle{display:none;background:none;border:none;color:var(--paper);font-size:20px;cursor:pointer;}

  @media(max-width:640px){
    nav.links{
      position:absolute;top:100%;left:0;right:0;
      background:var(--panel);
      flex-direction:column;gap:0;
      display:none;
      border-bottom:1px solid var(--line);
    }
    nav.links.open{display:flex;}
    nav.links a{padding:14px 28px;border-top:1px solid var(--line);}
    .navtoggle{display:block;}
  }

  /* ---------- Hero ---------- */
  .hero{
    padding:96px 0 72px;
    border-bottom:1px solid var(--line);
  }
  .prompt-line{
    font-family:'JetBrains Mono',monospace;
    color:var(--moss);
    font-size:13px;
    margin-bottom:22px;
  }
  .prompt-line .cursor{
    display:inline-block;width:8px;height:14px;background:var(--amber);
    margin-left:4px;animation:blink 1.1s step-end infinite;vertical-align:-2px;
  }
  @keyframes blink{50%{opacity:0;}}

  h1.name{
    font-family:'JetBrains Mono',monospace;
    font-weight:800;
    font-size:clamp(34px,6vw,58px);
    line-height:1.08;
    letter-spacing:-0.5px;
    max-width:14ch;
  }
  .role{
    margin-top:18px;
    font-size:19px;
    color:var(--paper-dim);
    max-width:52ch;
  }
  .hero-meta{
    margin-top:34px;
    display:flex;flex-wrap:wrap;gap:14px 28px;
    font-size:14px;
    color:var(--paper-dim);
  }
  .hero-meta a:hover{color:var(--amber);}
  .hero-meta .sep{color:var(--line);}

  /* ---------- Section shell ---------- */
  section{
    padding:64px 0;
    border-bottom:1px solid var(--line);
  }
  .kicker{
    font-family:'JetBrains Mono',monospace;
    font-size:13px;
    color:var(--moss);
    margin-bottom:10px;
  }
  .kicker::before{content:"// ";color:var(--paper-dim);}
  h2{
    font-family:'JetBrains Mono',monospace;
    font-size:26px;
    font-weight:700;
    margin-bottom:34px;
  }

  /* ---------- Education ---------- */
  .edu-row{
    display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:8px;
    padding:18px 0;
  }
  .edu-degree{font-size:17px;font-weight:600;}
  .edu-school{color:var(--paper-dim);font-size:15px;margin-top:4px;}
  .edu-right{
    text-align:right;font-family:'JetBrains Mono',monospace;font-size:14px;color:var(--amber);
  }

  /* ---------- Skills ---------- */
  .skill-grid{
    display:grid;
    grid-template-columns:150px 1fr;
    gap:18px 24px;
  }
  .skill-cat{
    font-family:'JetBrains Mono',monospace;
    font-size:13px;color:var(--paper-dim);
    padding-top:2px;
  }
  .skill-vals{
    display:flex;flex-wrap:wrap;gap:9px;
  }
  .chip{
    border:1px solid var(--line);
    padding:6px 13px;
    border-radius:3px;
    font-size:14px;
    color:var(--paper);
  }
  @media(max-width:560px){
    .skill-grid{grid-template-columns:1fr;}
    .skill-cat{padding-top:0;}
  }

  /* ---------- Project ---------- */
  .project-card{
    border:1px solid var(--line);
    border-left:3px solid var(--amber);
    padding:28px 26px;
    background:var(--panel);
  }
  .project-title{
    font-size:19px;font-weight:700;margin-bottom:6px;
  }
  .project-stack{
    font-family:'JetBrains Mono',monospace;
    font-size:12.5px;color:var(--moss);margin-bottom:16px;
  }
  .project-card ul{
    list-style:none;
    display:flex;flex-direction:column;gap:10px;
  }
  .project-card li{
    padding-left:20px;position:relative;
    color:var(--paper-dim);font-size:15px;
  }
  .project-card li::before{
    content:"›";position:absolute;left:0;color:var(--amber);font-weight:700;
  }

  /* ---------- Certs & strengths ---------- */
  .two-col{
    display:grid;grid-template-columns:1fr 1fr;gap:48px;
  }
  @media(max-width:640px){.two-col{grid-template-columns:1fr;gap:40px;}}
  .list-plain{list-style:none;display:flex;flex-direction:column;gap:12px;}
  .list-plain li{
    padding-bottom:12px;border-bottom:1px dashed var(--line);
    font-size:15px;color:var(--paper-dim);
    display:flex;justify-content:space-between;gap:10px;
  }
  .list-plain li:last-child{border-bottom:none;}
  .list-plain li span.tag{
    font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--moss);white-space:nowrap;
  }

  /* ---------- Contact ---------- */
  .contact{
    padding:72px 0 90px;
    border-bottom:none;
  }
  .contact h2{margin-bottom:16px;}
  .contact p{color:var(--paper-dim);max-width:48ch;margin-bottom:36px;font-size:16px;}
  .contact-grid{
    display:flex;flex-wrap:wrap;gap:14px;
  }
  .contact-btn{
    border:1px solid var(--line);
    padding:14px 22px;
    font-size:14.5px;
    display:flex;align-items:center;gap:10px;
    transition:border-color .15s ease, color .15s ease;
  }
  .contact-btn:hover{border-color:var(--amber);color:var(--amber);}

  footer{
    padding:28px 0 50px;
    text-align:center;
    font-size:13px;
    color:var(--paper-dim);
    font-family:'JetBrains Mono',monospace;
  }
</style>
</head>
<body>

